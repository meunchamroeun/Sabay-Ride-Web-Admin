# Default backend for the dashboard (admins can switch on the login screen).
#   staging    → https://sabayride-staging.cavkim.tech  (payments settle instantly, no QR)
#   production → https://sabayride.cavkim.tech          (real ABA KHQR, stays PENDING)
NEXT_PUBLIC_API_ENV=staging
# Optional: override the URL of the default backend above.
# NEXT_PUBLIC_API_BASE_URL=https://sabayride-staging.cavkim.tech
# Local sample-data admin for UI work (developers only; off by default, never set in Vercel).
# NEXT_PUBLIC_DEMO_ADMIN=true
# Admin screens whose API now exists (they show "Coming soon" until listed here).
#   Keys: bookings,motorbikes,users,reports,audit,blog
# NEXT_PUBLIC_API_READY=
